

<div class="container">
    <div class="row justify-content-center">
        <h1 id="title">Đăng Nhập</h1>
            <div class="box box-primary align-content-center">
                <div class="box-body">

                    <!-- Form Đăng Ký -->
                    <form id="registerForm" class="hidden">
                        <div class="form-group">
                            <label>Tên Hiển Thị:</label>
                            <input type="text" class="form-control" id="name" required autofocus>
                        </div>
                        <div class="form-group">
                            <label>Username:</label>
                        <input type="text" class="form-control" id="usernameReg" >
                        </div>
                        <div class="form-group">
                            <label>Password:</label>
                        <input type="password" class="form-control" id="passwordReg" required>
                        </div>
                        <div class="form-group">
                            <label>Email:</label>
                        <input type="email" class="form-control" id="email" required>
                        </div>
                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-primary" onclick="register()">
                                <i class="fa fa-sign-in"></i> Đăng Ký
                            </button>
                            <a href="#Login" class="btn btn-default" onclick="showLoginForm()">
                                Đăng Nhập
                            </a>
                        </div>
                    </form>

                    <!-- Form Đăng Nhập -->
                    <form id="loginForm">
                        <div class="form-group">
                            <label>Username:</label>
                            <input type="text" class="form-control" id="usernameLogin" autofocus required>
                        </div>
                        <div class="form-group">
                            <label>Password:</label>
                        <input type="password" class="form-control" id="passwordLogin" required>
                        </div>
                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-primary" onclick="login()">
                                <i class="fa fa-sign-in"></i> Đăng Nhập
                            </button>
                            <a href="#Register" class="btn btn-default" onclick="showRegisterForm()">
                                Đăng Ký
                            </a>
                        </div>
                    </form>                
                    <script src="~/js/authenticate.js"></script>
                </div>
            </div>
        
    </div>
</div>