    @model Account
@{
    ViewBag.Title = "Thông tin tài khoản";
}
<h1>@ViewBag.Title</h1>
<div class="box box-primary">
    <div class="box-body">
            <div class="form-group">
                <label>Tên Đăng Nhập:</label>
                <p class="form-control-static" id="userName">@Model.Username</p>
            </div>
            <div class="form-group">
                <label>Tên Hiển Thị:</label>
                <p class="form-control-static name-display">@Model.FullName</p>
                <input type="text" name="Name" class="form-control name-input" value="@Model.FullName" style="display:none;" />
            </div>
            <div class="form-group">
                <label>Email:</label>
                <p class="form-control-static email-display">@Model.Email</p>
                <input type="email" name="Email" class="form-control email-input" value="@Model.Email" style="display:none;" />
            </div>
            <div class="form-group text-right">
                <button type="button" class="btn btn-primary" id="editButton">
                    <i class="fa fa-pencil-square-o"></i>
                    Sửa Tài Khoản
                </button>
                <a class="btn btn-success" id="saveButton" style="display:none;" onclick="edit()">
                    <i class="fa fa-save"></i>
                    Lưu Lại
                </a>
                <a href="#" data-url="CancelAccount/@Model.UserID" class="btn btn-danger" id="removeAccount">
                    <i class="fa fa-trash"></i>
                    Huỷ Tài Khoản
                </a>
                <a href="~/Home" class="btn btn-default" id="backToHome">
                    <i class="fa fa-reply"></i>
                    Quay Lại
                </a>
                <a href="~/User" class="btn btn-default" style="display:none;" id="backToUser">
                    <i class="fa fa-reply"></i>
                    Quay Lại
                </a>
            </div>
    </div>
</div>

<div id="dialogModal" class="modal fade" role="dialog">
</div>
<script>
    document.getElementById('removeAccount').addEventListener('click', function (e) {
        e.preventDefault();
        var link = $(this).data("url");
        $.ajax({
            url: link,
            type: "GET",
            error: function (xhr, status, error) {
                alert("Đã xảy ra lỗi: " + error);
                console.error(xhr.responseText);
            },
            success: function (data) {
                $("#dialogModal").modal('hide');
                $("#dialogModal").empty();
                $("#dialogModal").html(data);
                $("#dialogModal").modal({ backdrop: 'static', keyboard: false });
            }
        });
    });
    document.getElementById('editButton').addEventListener('click', function () {

        document.querySelectorAll('.name-display').forEach(function (element) {
            element.style.display = 'none';
        });
        document.querySelectorAll('.name-input').forEach(function (element) {
            element.style.display = 'block';
        });
        document.querySelectorAll('.email-display').forEach(function (element) {
            element.style.display = 'none';
        });
        document.querySelectorAll('#removeAccount').forEach(function (element) {
            element.style.display = 'none';
        });
        document.querySelectorAll('#backToUser').forEach(function (element) {
            element.style.removeProperty('display');
        });
        document.querySelectorAll('#backToHome').forEach(function (element) {
            element.style.display = 'none';
        });
        document.querySelectorAll('.email-input').forEach(function (element) {
            element.style.display = 'block';
        });
        document.getElementById('editButton').style.display = 'none';
        document.getElementById('saveButton').style.removeProperty('display');
    });

    function edit() {
        var name = $('.name-input').val();
        var email = $('.email-input').val();

        var formEdit = {
            @nameof(Model.UserID): `@Model.UserID`,
            @nameof(Model.Username): `@Model.Username`,
            @nameof(Model.Password): `@Model.Password`,
            @nameof(Model.FullName): name,
            @nameof(Model.Email): email
        };

        $.ajax({
            type: "POST",
            url: "./Edit",
            data: formEdit,
            success: function (response) {
                alert(response.message);
                if (response.success) {
                    window.location.href = "./";
                }
            }
        });
    }

</script>