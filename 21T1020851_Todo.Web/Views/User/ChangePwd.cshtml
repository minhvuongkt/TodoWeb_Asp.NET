@{
    ViewData["TaskTitle"] = "Đổi Mật Khẩu";
}
<h2>@ViewBag.Title</h2>
<div class="box box-primary">
    <div class="box-body">
        <form>
            <div class="form-group">
                <label>Mật khẩu cũ:</label>
                <input type="password" class="form-control" id="oldPass" required />
            </div>
            <div class="form-group">
                <label>Mật khẩu mới:</label>
                <input type="password" class="form-control" id="newPass" required />
            </div>
            <div class="form-group text-right">
                <a class="btn btn-success" id="saveButton" onclick="changepass()">
                    <i class="fa fa-save"></i>
                    Lưu Lại
                </a>
                <a href="~/User" class="btn btn-default" id="backToUser">
                    <i class="fa fa-reply"></i>
                    Quay Lại
                </a>
            </div>
        </form>
        <script src="~/js/changepass.js"></script>
    </div>
</div>
