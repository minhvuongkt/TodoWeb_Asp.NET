@model SettingView

<h1>@ViewBag.Title</h1>
<div class="box box-primary">
    <div class="box-body">
        @Html.ValidationMessage("Error")
        <form action="~/SettingView/Save" method="post">
            <input type="hidden" name="@nameof(Model.UserID)" value="@Model.UserID" />
            
            <div class="form-group">
                <label>1. Kiểu Sắp Xếp:</label><br><br>
                    <label class="radio-inline">
                        <input type="radio" name="@nameof(Model.ViewPage)" value="1" @(Model.ViewPage == 1 ? "checked" : "")>Xếp Theo Từ A-Z
                </label><br><br>
                    <label class="radio-inline">
                        <input type="radio" name="@nameof(Model.ViewPage)" value="2" @(Model.ViewPage == 2 ? "checked" : "")>Xếp Theo Từ Z-A
                </label><br><br>
                    <label class="radio-inline">
                        <input type="radio" name="@nameof(Model.ViewPage)" value="3" @(Model.ViewPage == 3 ? "checked" : "")>Xếp Tăng Dần (Công việc từ cũ nhất -> mới nhất)
                </label><br><br>
                    <label class="radio-inline">
                        <input type="radio" name="@nameof(Model.ViewPage)" value="4" @(Model.ViewPage == 4 ? "checked" : "")>Xếp Giảm Dần (Công việc từ mới nhất -> cũ nhất)
                </label><br><br><br>
                
            </div>
            <div class="form-group">
                <label>2. Kiểu Hiển Thị:</label><br><br>
                    <label class="radio-inline">
                        <input type="radio" name="@nameof(Model.StyleView)" value="1" @(Model.StyleView == 1 ? "checked" : "")>Dạng Bảng (Table)
                </label><br><br>
                    <label class="radio-inline">
                        <input type="radio" name="@nameof(Model.StyleView)" value="2" @(Model.StyleView == 2 ? "checked" : "")>Dạng Thẻ (Card)
                </label><br><br><br>
                
            </div>
            <div class="form-group">
                <label>3. Kiểu Dữ Liệu Hiển Thị:</label>
                <br><br>
                    <label class="radio-inline">
                    <input type="radio" name="@nameof(Model.TypeView)" value="1" @(Model.TypeView == 1 ? "checked" : "")>Chỉ Hiển Thị Những Công Việc Đã Hoàn Thành
                </label><br><br>
                    <label class="radio-inline">
                    <input type="radio" name="@nameof(Model.TypeView)" value="2" @(Model.TypeView == 2 ? "checked" : "")>Chỉ Hiển Thị Những Công Việc Chưa Hoàn Thành
                </label><br><br>
                    <label class="radio-inline">
                    <input type="radio" name="@nameof(Model.TypeView)" value="3" @(Model.TypeView == 3 ? "checked" : "")>Hiển Thị Tất Cả Công Việc
                </label><br><br><br>
                
            </div>
            <div class="form-group text-right">
                <button type="submit" class="btn btn-default">
                    <i class="fa fa-save"></i>
                    Lưu Dữ Liệu
                </button>
                <a href="~/" class="btn btn-danger">
                    <i class="fa fa-reply"></i>
                    Quay Lại
                </a>
            </div>
        </form>
    </div>
</div>