@{
    Layout = null;
    @model TodoTask
}
<div class="modal-dialog">
    <div class="modal-content">
        <form class="form-horizontal" method="post" action="~/Todo/Update">
            <input type="hidden" name="@nameof(Model.TaskID)" value="@Model.TaskID" />
            <div class="modal-header bg-primary">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title text-center">Cập nhật công việc</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="control-label col-sm-3">Tên Công Việc:</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" name="@nameof(Model.TaskTitle)" value="@Model.TaskTitle" autofocus />
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-sm-3">Mô Tả Công Việc:</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" name="@nameof(Model.TaskDescription)" value="@Model.TaskDescription" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-sm-3">Trạng Thái:</label>
                    <div class="col-sm-9">
                        <select class="form-control" name="@nameof(Model.IsFinished)">
                            @{
                                if (Model.IsFinished)
                                {
                                        <option value="true" selected>Đã Hoàn Thành</option>
                                        <option value="false">Chưa Hoàn Thành</option>
                                }
                                else
                                {
                                    <option value="true">Đã Hoàn Thành</option>
                                    <option value="false" selected>Chưa Hoàn Thành</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <input type="hidden" name="@nameof(Model.UserID)" value="@HttpContextAccessor.HttpContext?.Session.GetInt32("UserID")" />
                <div class="form-group">
                    <label class="control-label col-sm-3">Thời Gian Bắt Đầu:</label>
                    <div class="col-sm-9">
                        <input type="datetime-local" class="form-control" name="@nameof(Model.TimeStart)" value="@Model.TimeStart.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-sm-3">Thời Gian Kết Thúc:</label>
                    <div class="col-sm-9">
                        <input type="datetime-local" class="form-control" name="@nameof(Model.TimeEnd)" value="@Model.TimeEnd.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-floppy-o"></i> Cập nhật
                </button>
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    Bỏ qua
                </button>
            </div>
        </form>
    </div>
</div>
