@model TodoTask

<h2>@ViewBag.Title</h2>
<div class="box box-primary">
    <div class="box-body">
        <form class="form-horizontal" action="~/Todo/Create" method="post">
            <div class="form-group">
                <label class="control-label col-sm-2">Tên Công Việc:</label>
                <div class="col-sm-10">
                    @Html.ValidationMessage(nameof(Model.TaskTitle))
                    <input type="text" class="form-control" name="@nameof(Model.TaskTitle)" autofocus />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-sm-2">Mô Tả Công Việc:</label>
                <div class="col-sm-10">
                    @Html.ValidationMessage(nameof(Model.TaskDescription))
                    <input type="text" class="form-control" name="@nameof(Model.TaskDescription)" />
                </div>
            </div>
            <input type="hidden" name="@nameof(Model.IsFinished)" value="false" />
            <div class="form-group">
                <label class="control-label col-sm-2">Thời Gian Bắt Đầu:</label>
                <div class="col-sm-10">
                    @Html.ValidationMessage("timeerror")
                    <input type="datetime-local" class="form-control" name="@nameof(Model.TimeStart)" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-2">Thời Gian Kết Thúc:</label>
                <div class="col-sm-10">
                    @Html.ValidationMessage("timeerror")
                    <input type="datetime-local" class="form-control" name="@nameof(Model.TimeEnd)" />
                </div>
            </div>
            <input type="hidden" name="@nameof(Model.UserID)" value="@HttpContextAccessor.HttpContext?.Session.GetInt32("UserID")" />

            <div class="form-group">
                <div class="col-lg-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-floppy-o"></i>
                        Lưu dữ liệu
                    </button>
                    <a href="../" class="btn btn-default">
                        Quay lại
                    </a>
                </div>
            </div>
        @* <script src="~/js/createtask.js"> </script> *@
        </form>
    </div>
</div>